generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  userCode         String    @unique
  passwordHash     String
  role             String    @default("STAFF")
  lastName         String
  firstName        String
  lastNameKana     String?
  firstNameKana    String?
  employmentType   String
  hourlyWage       Decimal?
  monthlySalary    Decimal?
  email            String?
  phone            String?
  hireDate         DateTime?
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Group {
  id          String   @id @default(uuid())
  name        String
  color       String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model UserGroup {
  userId   String
  groupId  String
  isLeader Boolean @default(false)

  @@id([userId, groupId])
  @@index([groupId])
}

model ShiftType {
  id           String  @id @default(uuid())
  name         String
  startTime    String
  endTime      String
  breakMinutes Int     @default(60)
  color        String?
  isOvernight  Boolean @default(false)
  isNightShift Boolean @default(false)
  isActive     Boolean @default(true)
}

model Shift {
  id          String   @id @default(uuid())
  userId      String
  shiftTypeId String?
  shiftDate   DateTime
  startTime   String?
  endTime     String?
  status      String   @default("DRAFT")
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, shiftDate])
  @@index([shiftDate, status])
}

model Attendance {
  id               String    @id @default(uuid())
  userId           String
  workDate         DateTime
  punchIn          DateTime?
  punchOut         DateTime?
  breakStart       DateTime?
  breakEnd         DateTime?
  status           String?
  shiftTypeId      String?
  baseMinutes      Int?
  isNightShift     Boolean   @default(false)
  workMinutes      Int?
  overtimeMinutes  Int       @default(0)
  lateNightMinutes Int       @default(0)
  isHolidayWork    Boolean   @default(false)
  notes            String?
  modifiedBy       String?
  modifyReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, workDate])
  @@index([workDate])
}

model SalaryItem {
  id          String   @id @default(uuid())
  code        String?  @unique
  name        String
  itemType    String
  calcType    String
  calcFormula String?
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Payroll {
  id             String    @id @default(uuid())
  userId         String
  year           Int
  month          Int
  status         String    @default("DRAFT")
  totalIncome    Decimal   @default(0)
  totalDeduction Decimal   @default(0)
  netPay         Decimal   @default(0)
  workDays       Int       @default(0)
  workMinutes    Int       @default(0)
  overtimeMinutes Int      @default(0)
  lateNightMinutes Int     @default(0)
  confirmedAt    DateTime?
  confirmedBy    String?
  modifiedBy     String?
  modifyReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, year, month])
  @@index([year, month])
}

model PayrollDetail {
  id           String  @id @default(uuid())
  payrollId    String
  salaryItemId String
  amount       Decimal @default(0)
  notes        String?
  sortOrder    Int     @default(0)
}

model ShiftRequest {
  id          String    @id @default(uuid())
  userId      String
  requestType String
  targetDate  DateTime?
  shiftTypeId String?
  reason      String?
  priority    Int       @default(1)
  status      String    @default("PENDING")
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model ShiftRequirement {
  id            String   @id @default(uuid())
  shiftTypeId   String
  dayOfWeek     Int?
  dateType      String   @default("ALL")
  requiredStaff Int      @default(1)
  groupId       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model ShiftRule {
  id          String   @id @default(uuid())
  ruleType    String   @unique
  value       Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model StaffConstraint {
  id                  String   @id @default(uuid())
  userId              String   @unique
  maxWorkDaysPerMonth Int?
  maxNightShifts      Int?
  availableDays       String?
  unavailableDates    String?
  preferredShiftTypes String?
  skillLevel          String   @default("NORMAL")
  canWorkNight        Boolean  @default(true)
  requiresPairing     Boolean  @default(false)
  pairingWithUserId   String?
  notPairWithUserId   String?
  notes               String?
  updatedAt           DateTime @updatedAt
}

model ShiftGenerationLog {
  id            String   @id @default(uuid())
  year          Int
  month         Int
  groupId       String?
  status        String
  fulfilledRate Float
  warnings      String?
  generatedBy   String
  createdAt     DateTime @default(now())
}

model GroupShiftConfig {
  id                      String   @id @default(uuid())
  groupId                 String   @unique
  maxConsecutive          Int?
  maxNightPerMonth        Int?
  enableFairDistribution  Boolean  @default(true)
  fairDistributionTarget  String   @default("ALL")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model StaffShiftStats {
  id           String   @id @default(uuid())
  userId       String
  year         Int
  month        Int
  nightCount   Int      @default(0)
  earlyCount   Int      @default(0)
  lateCount    Int      @default(0)
  dayCount     Int      @default(0)
  holidayCount Int      @default(0)
  totalWorkDays Int     @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([userId, year, month])
}

// ---- Phase 5: 有給休暇 / 36協定 / シフト交代 / 監査ログ ----

model PaidLeaveGrant {
  id            String   @id @default(uuid())
  userId        String
  grantDate     DateTime
  grantedDays   Float
  expiryDate    DateTime
  usedDays      Float    @default(0)
  remainingDays Float
  fiscalYear    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([userId, fiscalYear])
}

model PaidLeaveUsage {
  id           String   @id @default(uuid())
  userId       String
  grantId      String
  usedDate     DateTime
  days         Float    @default(1.0)
  status       String   @default("PENDING") // PENDING / APPROVED / REJECTED
  reason       String?
  attendanceId String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model OvertimeLimitConfig {
  id                   String   @id @default(uuid())
  monthlyLimitHours    Int      @default(45)
  yearlyLimitHours     Int      @default(360)
  specialMonthlyLimit  Int      @default(100)
  specialYearlyLimit   Int      @default(720)
  warningThresholdRate Float    @default(0.8)
  updatedAt            DateTime @updatedAt
}

model OvertimeMonthlyStats {
  id            String   @id @default(uuid())
  userId        String
  year          Int
  month         Int
  overtimeHours Float    @default(0)
  yearlyTotal   Float    @default(0)
  alertLevel    String   @default("NORMAL")
  updatedAt     DateTime @updatedAt

  @@unique([userId, year, month])
}

model ShiftSwapRequest {
  id                String    @id @default(uuid())
  originalUserId    String
  shiftId           String
  reason            String
  urgency           String    @default("URGENT")
  status            String    @default("OPEN")
  replacementUserId String?
  notifiedUserIds   String?
  approvedBy        String?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([status])
  @@index([originalUserId])
}

model ShiftSwapResponse {
  id            String   @id @default(uuid())
  swapRequestId String
  userId        String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  @@index([swapRequestId])
  @@index([userId])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  targetType  String?
  targetId    String?
  beforeValue String?
  afterValue  String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
