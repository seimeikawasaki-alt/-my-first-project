# Macの場合: postgresql://あなたのMacユーザー名@localhost:5432/careshift
# 例: postgresql://yamada@localhost:5432/careshift
# ターミナルで whoami を実行するとユーザー名がわかります
DATABASE_URL="postgresql://あなたのMacユーザー名@localhost:5432/careshift"
JWT_SECRET="careshift-secret-key-2024"
JWT_EXPIRES_IN="8h"
PORT=3000
NODE_ENV=development
VITE_API_BASE_URL="http://localhost:3000/api/v1"
