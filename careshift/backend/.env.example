# ─── データベース ───
# Mac の場合: postgresql://<Macユーザー名>@localhost:5432/careshift
# 例: postgresql://yamada@localhost:5432/careshift（whoami でユーザー名を確認）
DATABASE_URL="postgresql://user:password@localhost:5432/careshift"

# ─── 認証 ───
# 本番では 32 文字以上のランダム文字列に変更すること
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="8h"

# ─── サーバー ───
PORT=3000
NODE_ENV=development   # 本番は production に変更

# ─── CORS ───
CORS_ORIGIN="http://localhost:5173"  # 本番はドメインに変更

# ─── 給与明細 ───
FACILITY_NAME="CareShift 介護施設"   # 給与明細PDFに表示する施設名

# ─── フロントエンド ───
VITE_API_BASE_URL="http://localhost:3000/api/v1"
